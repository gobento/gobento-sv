# Copy to .env. With MOCK=true and no DATABASE_URL the app runs fully offline:
# an in-process Postgres with demo data, in-memory image storage, mocked payment
# providers and one-click demo sign-in. Never set MOCK=true in production.
MOCK=true
DATABASE_URL=

APP_URL=localhost
PUBLIC_APP_URL=http://localhost:3021
PUBLIC_NTFY_SERVER=
NTFY_SERVER=
PUBLIC_PAYMENT_FEE=5
FEE_PERCENTAGE=5

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3021/auth/callback/google

BACKBLAZE_KEY_ID=mock
BACKBLAZE_APPLICATION_KEY=mock
BACKBLAZE_BUCKET_NAME=mock
BACKBLAZE_REGION=us-west-000
BACKBLAZE_ENDPOINT=http://localhost:9000

PAYMENT_WEBHOOK_SECRET=mock
ZARINPAL_WEBHOOK_SECRET=mock
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
TETHER_CONTRACT_ADDRESS=
TETHER_PRIVATE_KEY=
ETHEREUM_RPC_URL=

MAIL_USER=
MAIL_PASS=

# Company SSO: encrypts stored OIDC client secrets. Generate with `openssl rand -base64 32`.
SSO_SECRET_KEY=
